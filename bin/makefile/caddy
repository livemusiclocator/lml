#!/usr/bin/env bash

domains=(
    "adelaide.lml.test"
    "gigs.lml.test"
    "perth.lml.test"
    "sydney.lml.test"
)

# serves the frontend client's built bundles the way
# assets.livemusiclocator.com.au serves them in production
asset_domains=(
    "assets.lml.test"
)

# relative to the repo the caddy target was run from (lml, lml_rb) - all siblings
asset_root="$(pwd)/../lml_frontend_client/dists/firebase_root"

rails_domains=(
    "lml.test"
    "api.lml.test"
    "brisbane.lml.test"
    "castlemaine.lml.test"
    "geelong.lml.test"
    "goldfields.lml.test"
    "livemusiclocator.com.test"
    "melbourne.lml.test"
    "stkilda.lml.test"
    "www.livemusiclocator.com.test"
)

rm caddyfile

for domain in "${domains[@]}"; do
  if [[ -z $(cat /etc/hosts | grep -e $domain) ]]; then
    echo "$domain missing from hosts file, adding now"
    echo "127.0.0.1 $domain" | sudo tee -a /etc/hosts
  fi

  echo "
  $domain {
    log
    root * /var/www
    encode zstd gzip
    tls internal
    reverse_proxy localhost:5173
  }
  " >>caddyfile
done

for domain in "${rails_domains[@]}"; do
  if [[ -z $(cat /etc/hosts | grep -e $domain) ]]; then
    echo "$domain missing from hosts file, adding now"
    echo "127.0.0.1 $domain" | sudo tee -a /etc/hosts
  fi

  echo "
  $domain {
    log
    root * /var/www
    encode zstd gzip
    tls internal
    reverse_proxy localhost:3000
  }
  " >>caddyfile
done

for domain in "${asset_domains[@]}"; do
  if [[ -z $(cat /etc/hosts | grep -e $domain) ]]; then
    echo "$domain missing from hosts file, adding now"
    echo "127.0.0.1 $domain" | sudo tee -a /etc/hosts
  fi

  echo "
  $domain {
    log
    root * $asset_root
    encode zstd gzip
    tls internal
    # the rails explorer layout loads these with crossorigin=anonymous, and the
    # dev bundle on firebase is served with a wildcard origin too
    header Access-Control-Allow-Origin *
    file_server
  }
  " >>caddyfile
done

caddy run
